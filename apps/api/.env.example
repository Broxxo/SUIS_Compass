# 复制为 apps/api/.env（勿提交仓库，已加入 .gitignore）
# Docker本地库（docker compose up -d）默认连接串：
DATABASE_URL=postgresql://suis:suis@127.0.0.1:5432/suis_compass

JWT_SECRET=change-me-to-a-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
PORT=8080

# API 连接池上限（默认 80）。建议为 Postgres max_connections 的约 70%～85%，勿顶满。
# 本地 Docker 库常见 max_connections=100 → 池用 80；Zeabur 单实例建议 PG_POOL_MAX=30。
# PG_POOL_MAX=80

# PostgreSQL SSL：Zeabur/Neon 等若连接失败可设 PGSSL=true；本地 Docker 保持 false 或不设。
# PGSSL=false

# Zeabur 部署变量清单见仓库根目录 zeabur.env.example

# 可选：AI
# SILICONFLOW_API_KEY=

# 可选：钉钉家校通讯录 · 学生同步（v0.5.1+，详见 docs/钉钉学生数据同步.md）
# DINGTALK_SYNC_ENABLED=true
# DINGTALK_APP_ID=be33be8e-8e61-49c4-8d05-21b112176065
# DINGTALK_AGENT_ID=4378680629
# DINGTALK_CLIENT_ID=dingmgcy0tkwjhib5eww
# DINGTALK_CLIENT_SECRET=   # 仅本地/生产密钥管理，勿提交 Git
# DINGTALK_API_MIN_INTERVAL_MS=200   # 钉钉 API 调用最小间隔（毫秒），默认 200，约 5 QPS
# DINGTALK_PREVIEW_CACHE_TTL_MS=300000 # 预览结果服务端缓存（毫秒），默认 5 分钟
