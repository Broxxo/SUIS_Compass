{
  "name": "@repo/api",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build -w @repo/shared && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "node scripts/init-db.mjs",
    "db:init:psql": "node -e \"require('dotenv').config(); const {execSync}=require('child_process'); execSync('psql $DATABASE_URL -f src/config/init.sql', {stdio:'inherit', env:process.env})\""
  },
  "dependencies": {
    "@repo/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
