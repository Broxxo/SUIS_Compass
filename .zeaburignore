# 本地项目上传到 Zeabur 时，以下路径/文件不必打包（平台会 npm install 并重新 build）
node_modules
.git
.cursor
**/.DS_Store
*.log

# 本地密钥与配置（绝不上传）
.env
.env.*
apps/api/.env
apps/web/.env

# 本地构建产物（平台会重新 npm run build）
dist
**/dist
apps/api/public
apps/api/dist

# 本地 Docker 与开发工具
docker-compose.yml
start-local-test.command

# 可选：减小上传体积
tools/load-tests/.env.local
